<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="hande_fingers" params="
    name:=''
    prefix:=''
    mount_x:=${2.01401 * 0.001}
    mount_y:=${-3.25000 * 0.001}
    mount_z:=${100.500 * 0.001}
    mount_roll:=${radians(0)}
    mount_pitch:=${radians(0)}
    mount_yaw:=${radians(0)}
    scale:=0.001">

    <link name="${prefix}finger_1_link">
      <visual>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dextivr_hande_description/meshes/imetro_finger_v2_m_vis.dae" />
          </geometry>
          <material name="${prefix}dark_gray"/>
      </visual>
      <collision>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dextivr_hande_description/meshes/imetro_finger_v2_m_col.dae"/>
          </geometry>
          <material name="${prefix}dark_gray"/>
      </collision>
    </link>

    <link name="${prefix}finger_2_link">
      <visual>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dextivr_hande_description/meshes/imetro_finger_v2_m_vis.dae" />
          </geometry>
          <material name="${prefix}dark_gray"/>
      </visual>
      <collision>
          <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://dextivr_hande_description/meshes/imetro_finger_v2_m_col.dae"/>
          </geometry>
          <material name="${prefix}dark_gray"/>
      </collision>
    </link>

    <joint name="${prefix}finger_1_joint" type="prismatic">
      <origin rpy="${mount_roll} ${mount_pitch} ${mount_yaw}" xyz="${mount_x} ${mount_y} ${mount_z}"/>
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_1_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="130" lower="0" upper="0.025" velocity="0.15"/>
    </joint>

    <joint name="${prefix}finger_2_joint" type="prismatic">
      <origin rpy="${mount_roll} ${mount_pitch} ${mount_yaw + pi}" xyz="${-mount_x} ${-mount_y} ${mount_z}"/>
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_2_link"/>
      <axis xyz="1 0 0"/>
      <limit effort="130" lower="0" upper="0.025" velocity="0.15"/>
      <mimic joint="${prefix}finger_1_joint" multiplier="1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>

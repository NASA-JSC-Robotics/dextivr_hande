<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_hande">
  <xacro:arg name="name" default="RobotiqGripperHandeHardwareInterface"/>
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:arg name="com_port" default="/dev/ttyACM0" />

  <xacro:arg name="marker_opacity" default="0.25" />
  <xacro:arg name="grasp_distance" default="0.148" />
  <xacro:arg name="finger_length" default="0.0605" />
  <xacro:arg name="push_marker_size" default="0.01" />

  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande.xacro"/>
  <xacro:include filename="$(find dextivr_hande_description)/urdf/hande_fingers_fngr_nail_v2.xacro"/>
  <xacro:include filename="$(find dextivr_hande_description)/urdf/fngr_nail_v2_grasp_push_frames.xacro"/>

  <link name="world"/>

  <xacro:robotiq_hande name="$(arg name)" prefix="$(arg prefix)" parent="world" use_fake_hardware="$(arg use_fake_hardware)" com_port="$(arg com_port)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_hande>

  <xacro:hande_fingers name="$(arg name)" prefix="$(arg prefix)"/>

  <xacro:grasp_push_frames name="$(arg name)" prefix="$(arg prefix)" marker_opacity="$(arg marker_opacity)" grasp_distance="$(arg grasp_distance)" finger_length="$(arg finger_length)" push_marker_size="$(arg push_marker_size)"/>

</robot>

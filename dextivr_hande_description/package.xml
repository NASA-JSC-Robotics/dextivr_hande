<?xml version="1.0"?>
<package format="3">
  <name>dextivr_hande_description</name>
  <version>1.0.0</version>
  <description>
    3D models of the Hand-E gripper for simulation and visualization with ER4 specific meshes.
  </description>
  <maintainer email="andrew.p.sharp@nasa.gov">Andrew Sharp</maintainer>
  <author>Abbas Presswala</author>
  <author>Amy Fritz</author>
  <license>Apache License, Version 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>robotiq_hande_description</depend>

  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

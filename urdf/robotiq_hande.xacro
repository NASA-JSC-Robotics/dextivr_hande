<?xml version="1.0"?>

<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_hande">
  <xacro:arg name="name" default="robotiq_hande"/>
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="jaw_xacro" default="standard" />
  <xacro:arg name="use_fake_hardware" default="false" />
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande.urdf.xacro"/>

  <link name="world"/>

  <xacro:robotiq_hande name="$(arg name)" prefix="$(arg prefix)" parent="world" use_fake_hardware="$(arg use_fake_hardware)" com_port="/dev/ttyUSB1">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_hande>

</robot>

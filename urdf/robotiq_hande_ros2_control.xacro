<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
 <xacro:macro name="robotiq_hande_ros2_control" params="name prefix use_fake_hardware:=false">
  <ros2_control name="${name}" type="system">
    <hardware>
      <xacro:if value="${use_fake_hardware}">
        <plugin>fake_components/GenericSystem</plugin>
      </xacro:if>
    </hardware>

    <joint name="${prefix}finger_1_joint">
      <param name="initial_position">0.00</param>
      <command_interface name="position">
        <param name="min">0.00</param>
        <param name="max">0.05</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
 </xacro:macro>
</robot>
